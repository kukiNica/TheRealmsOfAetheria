  abbility3Name: Florecer Astral
  abbility3Icon: {fileID: 21300000, guid: cc66ef7f49e8bf547874a7079852e1c0, type: 3}
  abbility3Description: "Hace brotar flores de Aether del suelo que explotan en luz,
