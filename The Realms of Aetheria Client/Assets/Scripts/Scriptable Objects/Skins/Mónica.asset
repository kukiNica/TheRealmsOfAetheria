  abbility1Name: "Lanza de P\xE9talos Radiantes"
  abbility1Icon: {fileID: 21300000, guid: da18ba0419ff31b4884fdbec5c918986, type: 3}
  abbility1Description: "Fayth concentra Aether en su mano y lanza una r\xE1faga
    de p\xE9talos dorados y rosados que da\xF1an a los enemigos."
  abbility2Name: 'Velo de Lythariel '
  abbility2Icon: {fileID: 21300000, guid: 5ade2c07441c8dd49a070670bd0505bf, type: 3}
  abbility2Description: "Invoca una barrera circular de luz blanca y dorada que reduce
