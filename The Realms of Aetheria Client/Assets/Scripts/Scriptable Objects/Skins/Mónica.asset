  abbility4Name: 'Canto del Alba Eterna '
  abbility4Icon: {fileID: 21300000, guid: 7fad34c5592cb454c9618e848e04c11c, type: 3}
  abbility4Description: "Fayth se eleva ligeramente en el aire mientras alas de luz
